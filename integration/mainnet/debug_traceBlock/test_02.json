[
  {
    "test": {
      "reference": "upstream Geth debug RPC",
      "description": "Compare debug_traceBlock prestateTracer in diff mode over the common block's RLP at a verified recent common nonempty block.",
      "tags": [
        "@full",
        "@pruned"
      ]
    },
    "referenceContext": "recent-block-v1",
    "request": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "debug_traceBlock",
      "params": [
        "$rawBlock",
        {
          "tracer": "prestateTracer",
          "tracerConfig": {
            "diffMode": true
          },
          "timeout": "30s"
        }
      ]
    }
  }
]
