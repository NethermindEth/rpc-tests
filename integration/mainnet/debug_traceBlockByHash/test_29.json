[
  {
    "test": {
      "reference": "upstream Geth debug RPC",
      "description": "Compare debug_traceBlockByHash muxTracer combining call, 4byte and prestate diff tracers at a verified recent common nonempty block.",
      "tags": [
        "@full",
        "@pruned"
      ]
    },
    "referenceContext": "recent-block-v1",
    "request": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "debug_traceBlockByHash",
      "params": [
        "$blockHash",
        {
          "tracer": "muxTracer",
          "tracerConfig": {
            "callTracer": {
              "withLog": true
            },
            "4byteTracer": {},
            "prestateTracer": {
              "diffMode": true
            }
          },
          "timeout": "30s"
        }
      ]
    }
  }
]
